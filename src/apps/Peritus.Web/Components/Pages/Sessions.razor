@page "/accounts/sessions"
@attribute [Authorize]
@using Peritus.ApiContracts.Identity
@using Peritus.ApiContracts.Identity.Accounts
@inject IIdentityApi Api

<PageTitle>Sessions</PageTitle>

<h1>Active Sessions</h1>

@if (_sessions is null)
{
    <p>Loading...</p>
}
else if (_sessions.Count == 0)
{
    <p>No active sessions.</p>
}
else
{
    <div class="list-group">
        @foreach (var session in _sessions)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    @session.UserAgent<br/>
                    <small class="text-muted">@session.IpAddress · Expires: @session.ExpiredAt.ToLocalTime()</small>
                </div>
                <EditForm method="post" Model="session" FormName="@($"Revoke_{session.Id}")" OnSubmit="HandleRevoke" Enhance>
                    <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                </EditForm>
            </div>
        }
    </div>

    <EditForm method="post" Model="_revokeAllForm" FormName="RevokeAll" OnSubmit="RevokeAllAsync" Enhance class="mt-3">
        <button type="submit" class="btn btn-danger">Revoke All Sessions</button>
    </EditForm>
}

@code {
    private List<SessionResponse>? _sessions;
    private readonly object _revokeAllForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSessionsAsync();
    }

    private async Task LoadSessionsAsync()
    {
        var response = await Api.GetUserSessionsAsync();
        if (response.IsSuccessful)
        {
            _sessions = response.Content;
        }
    }

    private async Task HandleRevoke(EditContext editContext)
    {
        var session = (SessionResponse)editContext.Model;
        var response = await Api.RevokeUserSessionAsync(session.Id);
        if (response.IsSuccessful)
        {
            await LoadSessionsAsync();
        }
    }

    public async Task RevokeAllAsync()
    {
        var response = await Api.RevokeAllSessionsAsync();
        if (response.IsSuccessful)
        {
            await LoadSessionsAsync();
        }
    }
}
