@page "/auth/signin"
@using Peritus.Identity.RestContracts
@using Peritus.Identity.RestContracts.Auth
@using Peritus.RestClients
@using Peritus.Types.Identity.Users
@using System.ComponentModel.DataAnnotations
@using Peritus.RestClients.Abstractions
@inject IIdentityApi Api
@inject ITokenStorage TokenStorage
@inject NavigationManager Navigation

<PageTitle>Sign In</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1>Sign In</h1>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        @if (_requiresTwoFactor)
        {
            <EditForm Model="TwoFactor" FormName="TwoFactorSignIn" OnSubmit="SubmitTwoFactorAsync" method="post" Enhance>
                <DataAnnotationsValidator/>
                <ValidationSummary class="text-danger"/>

                <input type="hidden" name="TwoFactor.TwoFactorToken" value="@_twoFactorToken"/>

                <div class="form-floating mb-3">
                    <InputText @bind-Value="TwoFactor.Code" class="form-control" autocomplete="off"/>
                    <label>Authentication Code</label>
                    <ValidationMessage For="() => TwoFactor.Code" class="text-danger"/>
                </div>

                <button type="submit" class="btn btn-primary w-100">Verify</button>
            </EditForm>
        }
        else
        {
            <EditForm Model="Input" FormName="SignIn" OnSubmit="SubmitAsync" method="post" Enhance>
                <DataAnnotationsValidator/>
                <ValidationSummary class="text-danger"/>

                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username"/>
                    <label>Email</label>
                    <ValidationMessage For="() => Input.Email" class="text-danger"/>
                </div>

                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Password" type="password" class="form-control" autocomplete="current-password"/>
                    <label>Password</label>
                    <ValidationMessage For="() => Input.Password" class="text-danger"/>
                </div>

                <button type="submit" class="btn btn-primary w-100">Sign In</button>
            </EditForm>

            <p class="mt-3 text-center">
                <a href="/auth/signup">Don't have an account? Sign up</a>
            </p>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    public SignInInput Input { get; set; } = null!;

    [SupplyParameterFromForm]
    public TwoFactorInput TwoFactor { get; set; } = null!;

    private string? _errorMessage;
    private string? _twoFactorToken;
    private bool _requiresTwoFactor;

    public async Task SubmitAsync()
    {
        _errorMessage = null;

        var response = await Api.SignInAsync(new SignInRequest
        {
            Email = new Email(Input.Email!),
            Password = new Password(Input.Password!)
        });

        if (!response.IsSuccessful || response.Content is null)
        {
            _errorMessage = "Invalid credentials.";
            return;
        }

        if (response.Content.RequiresTwoFactor)
        {
            _requiresTwoFactor = true;
            _twoFactorToken = response.Content.TwoFactorToken;
            return;
        }

        TokenStorage.SetTokens(response.Content.AccessToken!.Value, response.Content.RefreshToken!.Value);
        Navigation.NavigateTo(GetReturnUrl(), forceLoad: true);
    }

    public async Task SubmitTwoFactorAsync()
    {
        _errorMessage = null;

        var response = await Api.TwoFactorSignInAsync(new TwoFactorSignInRequest
        {
            TwoFactorToken = TwoFactor.TwoFactorToken!,
            Code = TwoFactor.Code!
        });

        if (!response.IsSuccessful || response.Content is null)
        {
            _errorMessage = "Invalid or expired code.";
            return;
        }

        TokenStorage.SetTokens(response.Content.AccessToken, response.Content.RefreshToken);
        Navigation.NavigateTo(GetReturnUrl(), forceLoad: true);
    }

    private string GetReturnUrl()
    {
        if (!string.IsNullOrEmpty(ReturnUrl) && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative))
        {
            return Uri.UnescapeDataString(ReturnUrl);
        }
        return "/";
    }

    public class SignInInput
    {
        [Required, EmailAddress]
        public string? Email { get; set; }

        [Required]
        public string? Password { get; set; }
    }

    public class TwoFactorInput
    {
        public string? TwoFactorToken { get; set; }

        [Required]
        public string? Code { get; set; }
    }
}
